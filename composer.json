{
  "name": "smart-referral-pro/plugin",
  "description": "Advanced referral system with wallet, coupons, and admin dashboard",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Smart Referral Pro Team",
      "email": "dev@smartreferral.pro"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "wp-coding-standards/wpcs": "^3.0",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.7",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "phpcs --standard=WordPress --ignore=vendor,node_modules --extensions=php .",
    "phpcbf": "phpcbf --standard=WordPress --ignore=vendor,node_modules --extensions=php .",
    "phpstan": "phpstan analyse --level=5 --no-progress",
    "lint": "find . -name '*.php' -not -path './vendor/*' -exec php -l {} \;",
    "validate": "php scripts/git-pusher.php validate"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
